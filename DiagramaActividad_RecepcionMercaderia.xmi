<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
  xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

  <uml:Model xmi:id="model1" name="DiagramasActividad">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg1" name="DiagramasActividad">
      <packagedElement xmi:type="uml:Activity" xmi:id="act1" name="Recepcion de Mercaderia">

        <!-- SWIMLANES -->
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_admin" name="Administrador" isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_prov"  name="Proveedor"     isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_alm"   name="Almacenero"    isDimension="true"/>

        <!-- NODOS -->
        <node xmi:type="uml:InitialNode"       xmi:id="n0"  name="Inicio"                        inPartition="sw_admin"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n1"  name="emite orden de compra"          inPartition="sw_admin"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n2"  name="recibe orden de compra"         inPartition="sw_prov"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n3"  name="prepara mercaderia"             inPartition="sw_prov"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n4"  name="entrega mercaderia y factura"   inPartition="sw_prov"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n5"  name="recibe mercaderia"              inPartition="sw_alm"/>
        <node xmi:type="uml:DecisionNode"      xmi:id="n6"  name="mercaderia conforme?"           inPartition="sw_alm"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n7"  name="rechaza mercaderia"             inPartition="sw_prov"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n8"  name="registra lote en sistema"       inPartition="sw_alm"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n9"  name="confirma recepcion"             inPartition="sw_alm"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="n10" name="verifica ingreso en inventario" inPartition="sw_admin"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="n11" name="Fin"                            inPartition="sw_admin"/>

        <!-- FLUJO -->
        <edge xmi:type="uml:ControlFlow" xmi:id="e0"  source="n0"  target="n1"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e1"  source="n1"  target="n2"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e2"  source="n2"  target="n3"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e3"  source="n3"  target="n4"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e4"  source="n4"  target="n5"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e5"  source="n5"  target="n6"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e6"  source="n6"  target="n7"  name="no"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e7"  source="n7"  target="n3"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e8"  source="n6"  target="n8"  name="si"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e9"  source="n8"  target="n9"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e10" source="n9"  target="n10" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="e11" source="n10" target="n11" name=""/>

      </packagedElement>
    </packagedElement>
  </uml:Model>

  <!-- ===== EA DIAGRAM LAYOUT EXTENSION ===== -->
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <diagrams>
      <diagram xmi:id="dg1">
        <model package="pkg1" owner="act1" type="Activity"/>
        <properties name="Recepcion de Mercaderia" type="Activity"/>
        <swimlanes orientation="0" width="220" count="3" bVerticalLayout="1"
                   swiLine="-1" swiWidth="220" swiFont="Arial;10;0"
                   ActivityPartition0="Administrador" ActivityPartition1="Proveedor" ActivityPartition2="Almacenero"/>
        <elements>
          <!-- Administrador: x 0-220 -->
          <element xmi:idref="n0"  geometry="Left=90;Top=60;Right=130;Bottom=100;"  seqno="1"  label="Inicio"/>
          <element xmi:idref="n1"  geometry="Left=20;Top=140;Right=200;Bottom=185;" seqno="2"  label="emite orden de compra"/>
          <element xmi:idref="n10" geometry="Left=20;Top=590;Right=200;Bottom=635;" seqno="3"  label="verifica ingreso en inventario"/>
          <element xmi:idref="n11" geometry="Left=90;Top=665;Right=130;Bottom=705;" seqno="4"  label="Fin"/>
          <!-- Proveedor: x 220-440 -->
          <element xmi:idref="n2"  geometry="Left=240;Top=210;Right=420;Bottom=255;" seqno="5"  label="recibe orden de compra"/>
          <element xmi:idref="n3"  geometry="Left=240;Top=290;Right=420;Bottom=335;" seqno="6"  label="prepara mercaderia"/>
          <element xmi:idref="n4"  geometry="Left=240;Top=370;Right=420;Bottom=415;" seqno="7"  label="entrega mercaderia y factura"/>
          <element xmi:idref="n7"  geometry="Left=240;Top=500;Right=420;Bottom=545;" seqno="8"  label="rechaza mercaderia"/>
          <!-- Almacenero: x 440-660 -->
          <element xmi:idref="n5"  geometry="Left=460;Top=430;Right=640;Bottom=475;" seqno="9"  label="recibe mercaderia"/>
          <element xmi:idref="n6"  geometry="Left=510;Top=500;Right=590;Bottom=580;" seqno="10" label="mercaderia conforme?"/>
          <element xmi:idref="n8"  geometry="Left=460;Top=600;Right=640;Bottom=645;" seqno="11" label="registra lote en sistema"/>
          <element xmi:idref="n9"  geometry="Left=460;Top=660;Right=640;Bottom=705;" seqno="12" label="confirma recepcion"/>
        </elements>
        <connectors>
          <connector xmi:idref="e0"/><connector xmi:idref="e1"/><connector xmi:idref="e2"/>
          <connector xmi:idref="e3"/><connector xmi:idref="e4"/><connector xmi:idref="e5"/>
          <connector xmi:idref="e6"/><connector xmi:idref="e7"/><connector xmi:idref="e8"/>
          <connector xmi:idref="e9"/><connector xmi:idref="e10"/><connector xmi:idref="e11"/>
        </connectors>
      </diagram>
    </diagrams>
  </xmi:Extension>

</xmi:XMI>
