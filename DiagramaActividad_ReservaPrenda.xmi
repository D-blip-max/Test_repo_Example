<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
  xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

  <uml:Model xmi:id="model2" name="DiagramasActividad">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg2" name="DiagramasActividad">
      <packagedElement xmi:type="uml:Activity" xmi:id="act2" name="Reserva de Prenda">

        <!-- SWIMLANES -->
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_cli"  name="Cliente"    isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_vend" name="Vendedor"   isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_alm2" name="Almacenero" isDimension="true"/>

        <!-- NODOS -->
        <node xmi:type="uml:InitialNode"       xmi:id="r0"  name="Inicio"                      inPartition="sw_cli"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r1"  name="solicita prenda"              inPartition="sw_cli"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r2"  name="consulta stock disponible"   inPartition="sw_vend"/>
        <node xmi:type="uml:DecisionNode"      xmi:id="r3"  name="hay stock disponible?"       inPartition="sw_vend"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r4"  name="informa sin stock"            inPartition="sw_vend"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="r4b" name="Fin"                          inPartition="sw_vend"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r5"  name="selecciona prenda y cantidad" inPartition="sw_vend"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r6"  name="registra datos del cliente"  inPartition="sw_vend"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r7"  name="confirma reserva en sistema" inPartition="sw_vend"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r8b" name="aparta prenda en almacen"    inPartition="sw_alm2"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="r8"  name="recibe codigo de reserva"    inPartition="sw_cli"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="r9"  name="Fin"                          inPartition="sw_cli"/>

        <!-- FLUJO -->
        <edge xmi:type="uml:ControlFlow" xmi:id="re0"  source="r0"  target="r1"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re1"  source="r1"  target="r2"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re2"  source="r2"  target="r3"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re3"  source="r3"  target="r4"  name="no"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re4"  source="r4"  target="r4b" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re5"  source="r3"  target="r5"  name="si"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re6"  source="r5"  target="r6"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re7"  source="r6"  target="r7"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re8"  source="r7"  target="r8b" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re9"  source="r8b" target="r8"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="re10" source="r8"  target="r9"  name=""/>

      </packagedElement>
    </packagedElement>
  </uml:Model>

  <!-- ===== EA DIAGRAM LAYOUT EXTENSION ===== -->
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <diagrams>
      <diagram xmi:id="dg2">
        <model package="pkg2" owner="act2" type="Activity"/>
        <properties name="Reserva de Prenda" type="Activity"/>
        <swimlanes orientation="0" width="220" count="3" bVerticalLayout="1"
                   ActivityPartition0="Cliente" ActivityPartition1="Vendedor" ActivityPartition2="Almacenero"/>
        <elements>
          <!-- Cliente: x 0-220 -->
          <element xmi:idref="r0"  geometry="Left=90;Top=60;Right=130;Bottom=100;"  seqno="1"  label="Inicio"/>
          <element xmi:idref="r1"  geometry="Left=20;Top=140;Right=200;Bottom=185;" seqno="2"  label="solicita prenda"/>
          <element xmi:idref="r8"  geometry="Left=20;Top=580;Right=200;Bottom=625;" seqno="3"  label="recibe codigo de reserva"/>
          <element xmi:idref="r9"  geometry="Left=90;Top=650;Right=130;Bottom=690;" seqno="4"  label="Fin"/>
          <!-- Vendedor: x 220-440 -->
          <element xmi:idref="r2"  geometry="Left=240;Top=200;Right=420;Bottom=245;" seqno="5"  label="consulta stock disponible"/>
          <element xmi:idref="r3"  geometry="Left=300;Top=275;Right=380;Bottom=355;" seqno="6"  label="hay stock disponible?"/>
          <element xmi:idref="r4"  geometry="Left=240;Top=380;Right=420;Bottom=425;" seqno="7"  label="informa sin stock"/>
          <element xmi:idref="r4b" geometry="Left=300;Top=450;Right=340;Bottom=490;" seqno="8"  label="Fin"/>
          <element xmi:idref="r5"  geometry="Left=240;Top=380;Right=420;Bottom=425;" seqno="9"  label="selecciona prenda y cantidad"/>
          <element xmi:idref="r6"  geometry="Left=240;Top=460;Right=420;Bottom=505;" seqno="10" label="registra datos del cliente"/>
          <element xmi:idref="r7"  geometry="Left=240;Top=540;Right=420;Bottom=585;" seqno="11" label="confirma reserva en sistema"/>
          <!-- Almacenero: x 440-660 -->
          <element xmi:idref="r8b" geometry="Left=460;Top=540;Right=640;Bottom=585;" seqno="12" label="aparta prenda en almacen"/>
        </elements>
        <connectors>
          <connector xmi:idref="re0"/><connector xmi:idref="re1"/><connector xmi:idref="re2"/>
          <connector xmi:idref="re3"/><connector xmi:idref="re4"/><connector xmi:idref="re5"/>
          <connector xmi:idref="re6"/><connector xmi:idref="re7"/><connector xmi:idref="re8"/>
          <connector xmi:idref="re9"/><connector xmi:idref="re10"/>
        </connectors>
      </diagram>
    </diagrams>
  </xmi:Extension>

</xmi:XMI>
