<?xml version="1.0" encoding="UTF-8"?>
<xmi:XMI xmi:version="2.1"
  xmlns:xmi="http://schema.omg.org/spec/XMI/2.1"
  xmlns:uml="http://www.eclipse.org/uml2/5.0.0/UML">

  <uml:Model xmi:id="model3" name="DiagramasActividad">
    <packagedElement xmi:type="uml:Package" xmi:id="pkg3" name="DiagramasActividad">
      <packagedElement xmi:type="uml:Activity" xmi:id="act3" name="Venta en Punto de Venta POS">

        <!-- SWIMLANES -->
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_cli2" name="Cliente"       isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_caj"  name="Cajero"        isDimension="true"/>
        <group xmi:type="uml:ActivityPartition" xmi:id="sw_adm"  name="Administrador" isDimension="true"/>

        <!-- NODOS -->
        <node xmi:type="uml:InitialNode"       xmi:id="v0"  name="Inicio"                               inPartition="sw_cli2"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v1"  name="presenta prendas o codigo de reserva" inPartition="sw_cli2"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v2"  name="carga prendas al carrito"             inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v3"  name="calcula total"                        inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v4"  name="elige metodo de pago"                 inPartition="sw_cli2"/>
        <node xmi:type="uml:DecisionNode"      xmi:id="v5"  name="metodo de pago?"                      inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v6"  name="ingresa monto recibido"               inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v7"  name="calcula vuelto"                       inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v8"  name="realiza pago electronico"             inPartition="sw_cli2"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v9"  name="verifica referencia de pago"          inPartition="sw_caj"/>
        <node xmi:type="uml:MergeNode"         xmi:id="v10" name=""                                     inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v11" name="confirma venta en sistema"            inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v12" name="emite recibo al cliente"              inPartition="sw_caj"/>
        <node xmi:type="uml:OpaqueAction"      xmi:id="v13" name="registra venta en historial"          inPartition="sw_adm"/>
        <node xmi:type="uml:ActivityFinalNode" xmi:id="v14" name="Fin"                                  inPartition="sw_adm"/>

        <!-- FLUJO -->
        <edge xmi:type="uml:ControlFlow" xmi:id="ve0"  source="v0"  target="v1"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve1"  source="v1"  target="v2"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve2"  source="v2"  target="v3"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve3"  source="v3"  target="v4"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve4"  source="v4"  target="v5"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve5"  source="v5"  target="v6"  name="Efectivo"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve6"  source="v6"  target="v7"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve7"  source="v7"  target="v10" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve8"  source="v5"  target="v8"  name="QR / Tarjeta"/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve9"  source="v8"  target="v9"  name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve10" source="v9"  target="v10" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve11" source="v10" target="v11" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve12" source="v11" target="v12" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve13" source="v12" target="v13" name=""/>
        <edge xmi:type="uml:ControlFlow" xmi:id="ve14" source="v13" target="v14" name=""/>

      </packagedElement>
    </packagedElement>
  </uml:Model>

  <!-- ===== EA DIAGRAM LAYOUT EXTENSION ===== -->
  <xmi:Extension extender="Enterprise Architect" extenderID="6.5">
    <diagrams>
      <diagram xmi:id="dg3">
        <model package="pkg3" owner="act3" type="Activity"/>
        <properties name="Venta en Punto de Venta POS" type="Activity"/>
        <swimlanes orientation="0" width="220" count="3" bVerticalLayout="1"
                   ActivityPartition0="Cliente" ActivityPartition1="Cajero" ActivityPartition2="Administrador"/>
        <elements>
          <!-- Cliente: x 0-220 -->
          <element xmi:idref="v0"  geometry="Left=90;Top=60;Right=130;Bottom=100;"  seqno="1"  label="Inicio"/>
          <element xmi:idref="v1"  geometry="Left=10;Top=140;Right=210;Bottom=185;" seqno="2"  label="presenta prendas o codigo de reserva"/>
          <element xmi:idref="v4"  geometry="Left=20;Top=320;Right=200;Bottom=365;" seqno="3"  label="elige metodo de pago"/>
          <element xmi:idref="v8"  geometry="Left=20;Top=470;Right=200;Bottom=515;" seqno="4"  label="realiza pago electronico"/>
          <!-- Cajero: x 220-440 -->
          <element xmi:idref="v2"  geometry="Left=240;Top=200;Right=420;Bottom=245;" seqno="5"  label="carga prendas al carrito"/>
          <element xmi:idref="v3"  geometry="Left=240;Top=275;Right=420;Bottom=320;" seqno="6"  label="calcula total"/>
          <element xmi:idref="v5"  geometry="Left=300;Top=385;Right=380;Bottom=465;" seqno="7"  label="metodo de pago?"/>
          <element xmi:idref="v6"  geometry="Left=240;Top=490;Right=420;Bottom=535;" seqno="8"  label="ingresa monto recibido"/>
          <element xmi:idref="v7"  geometry="Left=240;Top=555;Right=420;Bottom=600;" seqno="9"  label="calcula vuelto"/>
          <element xmi:idref="v9"  geometry="Left=240;Top=490;Right=420;Bottom=535;" seqno="10" label="verifica referencia de pago"/>
          <element xmi:idref="v10" geometry="Left=300;Top=620;Right=380;Bottom=660;" seqno="11" label=""/>
          <element xmi:idref="v11" geometry="Left=240;Top=680;Right=420;Bottom=725;" seqno="12" label="confirma venta en sistema"/>
          <element xmi:idref="v12" geometry="Left=240;Top=750;Right=420;Bottom=795;" seqno="13" label="emite recibo al cliente"/>
          <!-- Administrador: x 440-660 -->
          <element xmi:idref="v13" geometry="Left=460;Top=750;Right=640;Bottom=795;" seqno="14" label="registra venta en historial"/>
          <element xmi:idref="v14" geometry="Left=530;Top=820;Right=570;Bottom=860;" seqno="15" label="Fin"/>
        </elements>
        <connectors>
          <connector xmi:idref="ve0"/><connector xmi:idref="ve1"/><connector xmi:idref="ve2"/>
          <connector xmi:idref="ve3"/><connector xmi:idref="ve4"/><connector xmi:idref="ve5"/>
          <connector xmi:idref="ve6"/><connector xmi:idref="ve7"/><connector xmi:idref="ve8"/>
          <connector xmi:idref="ve9"/><connector xmi:idref="ve10"/><connector xmi:idref="ve11"/>
          <connector xmi:idref="ve12"/><connector xmi:idref="ve13"/><connector xmi:idref="ve14"/>
        </connectors>
      </diagram>
    </diagrams>
  </xmi:Extension>

</xmi:XMI>
